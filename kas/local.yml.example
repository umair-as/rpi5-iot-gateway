# Operator-private overlay. Copy to kas/local.yml (gitignored) and edit.
#
# Layers: this project uses the shared git-alternates mechanism (see the
# Makefile). Upstream layers are SHA-pinned in rpi5.yml / kas/*.yml and cloned
# into .kas/ (gitignored) using bare mirrors under KAS_REPO_REF_DIR (set in the
# gitignored scripts/env.local.sh; unset => full clones) as alternates —
# nothing to pre-clone, no path: overrides needed. For standalone `kas`
# (outside `make`), first run `. scripts/env.sh` to lift the KAS_* env into
# your shell.
header:
  version: 18
  includes:
    # Default to auto-fetch stack (RAUC-enabled by distro)
    - "kas/rpi5-autofetch.yml"

env:
  # Directory holding your RAUC signing keys. Prefer absolute path here.
  # Using $HOME is convenient, but expansion may depend on how kas is invoked.
  # If in doubt, replace with an absolute path (e.g., /home/you/rauc-keys).
  IOTGW_RAUC_KEY_DIR: "$HOME/rauc-keys"

local_conf_header:
  paths: |
    # Shared download + sstate caches on the NVMe drive so native/cross/allarch
    # sstate and all source downloads are reused. Point these at your shared drive.
    DL_DIR     = "/path/to/shared/downloads"
    SSTATE_DIR = "/path/to/shared/sstate"

  llvm_targets: |
    # LLVM backend list is a distro setting (LLVM_TARGETS_TO_BUILD in
    # iotgw-common.inc) so every host shares llvm/rust sstate. Override here only
    # to experiment; a per-host value stops that sharing.
    # LLVM_TARGETS_TO_BUILD = "AArch64;ARM;BPF;X86"

  wifi: |
    # Inject Wi‑Fi profiles (static IPv4) — create 'kas/local.yml' from this file and edit.
    # Multiple lines separated by \n; format: ssid|psk|iface|method|priority|ipv4addr/prefix|gateway|dns1;dns2
    IOTGW_WIFI_NETWORKS = "HomeWiFi|Secret|wlan0|manual|100|192.168.0.222/24|192.168.0.1|1.1.1.1;8.8.8.8\nESP|Secret2|wlan0|manual|100|192.168.28.50/24|192.168.28.1|1.1.1.1;8.8.8.8"
    # Regulatory domain (ISO 3166-1 alpha-2). No layer default; unset leaves the
    # world domain "00", which rejects or never scans most 5 GHz channels.
    IOTGW_WIFI_COUNTRY = "DE"
    # Every wlan0 route gets this metric (layer default 2048, above br0's 1024),
    # so the wired uplink wins when both are on the same subnet.
    # IOTGW_WIFI_ROUTE_METRIC = "2048"

  rauc_keys: |
    # Legacy flat-signed RAUC keys (single self-signed cert as both leaf signer
    # and device trust anchor). Keep this block during a migration window where
    # devices still carry the legacy single-cert keyring. Once devices boot the
    # directory-trust keyring configured via IOTGW_RAUC_KEYRING_CERTS below,
    # bundles can be re-signed with a chain-rooted leaf.
    # Store private keys outside the repo; adjust paths to your environment.
    # Prefer using IOTGW_RAUC_KEY_DIR defined in the 'env:' block above to avoid
    # relying on $HOME expansion in local_conf.
    RAUC_KEY_FILE = "${IOTGW_RAUC_KEY_DIR}/dev-key.pem"
    RAUC_CERT_FILE = "${IOTGW_RAUC_KEY_DIR}/dev-cert.pem"
  rauc_device_keyring: |
    # Single-cert keyring: trust anchor installed at /etc/rauc/ca.cert.pem.
    # Inert once IOTGW_RAUC_KEYRING_CERTS (below) is set — the recipe then
    # installs every listed cert into /etc/rauc/keyring.d/ instead, and RAUC's
    # [keyring] stanza switches from path= to directory=.
    RAUC_DEVICE_KEYRING = "${IOTGW_RAUC_KEY_DIR}/ca.cert.pem"
  rauc_pki_chain: |
    # === Chain-rooted RAUC PKI (Root → intermediate CA → annual signing leaf) ===
    # Layout under the operator's key tree:
    #   ${IOTGW_RAUC_KEY_DIR}/rauc-ca/root-ca/root-ca-<role>.crt        # exported Root cert(s)
    #   ${IOTGW_RAUC_KEY_DIR}/rauc-ca/dev-ca/dev-ca.cert.pem            # Dev intermediate
    #   ${IOTGW_RAUC_KEY_DIR}/rauc-ca/prod-ca/prod-ca.cert.pem          # Prod intermediate
    #   ${IOTGW_RAUC_KEY_DIR}/rauc-ca/issued/dev/iotgw-rauc-dev-signer-<YYYY>.{key,chain}.pem
    #
    # --- Transition image: dual-trust keyring (legacy + new Roots) ---
    # Bundles are still signed with the legacy key so devices on the single-cert
    # keyring can install this image; the new Roots are pre-positioned for the
    # following cutover.
    # IOTGW_RAUC_KEYRING_CERTS = " \
    #     ${IOTGW_RAUC_KEY_DIR}/dev-cert.pem \
    #     ${IOTGW_RAUC_KEY_DIR}/rauc-ca/root-ca/root-ca-primary.crt \
    #     ${IOTGW_RAUC_KEY_DIR}/rauc-ca/root-ca/root-ca-backup.crt"
    #
    # --- Cutover image: Root-only keyring; legacy signing retired ---
    # Bundles are signed with the new chain. The legacy cert is dropped from
    # the keyring directory; legacy-signed bundles will be rejected.
    # RAUC_KEY_FILE  = "${IOTGW_RAUC_KEY_DIR}/rauc-ca/issued/dev/iotgw-rauc-dev-signer-2026.key.pem"
    # RAUC_CERT_FILE = "${IOTGW_RAUC_KEY_DIR}/rauc-ca/issued/dev/iotgw-rauc-dev-signer-2026.chain.pem"
    # IOTGW_RAUC_KEYRING_CERTS = " \
    #     ${IOTGW_RAUC_KEY_DIR}/rauc-ca/root-ca/root-ca-primary.crt \
    #     ${IOTGW_RAUC_KEY_DIR}/rauc-ca/root-ca/root-ca-backup.crt"
    #
    # --- Optional prod CN allowlist (defence-in-depth on top of chain trust) ---
    # IOTGW_RAUC_ALLOWED_SIGNER_CNS = "iotgw-rauc-prod-signer-2026;iotgw-rauc-prod-signer-2027"
    #
    # --- Optional X.509 purpose enforcement on the signer chain ---
    # Leave empty during the transition (legacy signer cert typically has no
    # codeSigning EKU). Enable at the cutover image where every signing leaf
    # is chain-issued from a CA template that sets extendedKeyUsage = codeSigning.
    # IOTGW_RAUC_CHECK_PURPOSE = "codesign"
    #
    # --- Optional HSM-resident signing leaf (PKCS#11 URI form) ---
    # When the bundle-signing key lives in a hardware token instead of a file,
    # RAUC_KEY_FILE accepts a serial-anchored PKCS#11 URI. Examples:
    # RAUC_KEY_FILE = "pkcs11:token=<token-label>;id=<hex-id>;type=private"
    # RAUC_KEY_FILE = "pkcs11:token=atecc;object=rauc-signing-key;type=private"
  ota_ca_source: |
    # Optional: authoritative OTA mTLS CA source for ota-certs recipe.
    # Used to seed /etc/ota/ca.crt at build time and validate CA consistency.
    # Supported filenames in this directory:
    #   - ca.crt / ca.key
    #   - dev-ca.crt / dev-ca.key
    # Keep this aligned with simple-ota-server CA used to sign server/device certs.
    #
    # ALSO the default source of the RAUC crypt-bundle recipient: with bundles
    # encrypted by default, IOTGW_RAUC_BUNDLE_ENCRYPT_RECIPIENTS derives from
    # this directory. Setting it here is what makes a fresh clone able to build
    # a bundle at all.
    #
    # scripts/ota/ota-certs-sync.sh does NOT read this variable -- it has its
    # own --ca-dir (default $HOME/rauc-keys/ota-dev-ca). If you point
    # RAUC_OTA_CA_DIR anywhere else, pass the SAME directory when provisioning:
    #
    #   scripts/ota/ota-certs-sync.sh --ca-dir <the RAUC_OTA_CA_DIR value>
    #
    # Otherwise the build encrypts to the certificate in one directory while the
    # device is provisioned with the keypair from another, and the target cannot
    # decrypt what it is sent.
    RAUC_OTA_CA_DIR = "${IOTGW_RAUC_KEY_DIR}/ota-dev-ca"

  fit_signing: |
    # === FIT signing (REQUIRED) — the build FAILS without a usable key ===
    # FIT signed boot is the ONLY supported flow (enforced by
    # iotgw-fit-signing-guard.bbclass; there is no unsigned build). Point these
    # at YOUR operator-generated, gitignored file key (never committed).
    # Generate one per docs/FIT_BOOT_SIGNING.md ("Generate a dev signing key").
    UBOOT_SIGN_KEYDIR  = "${IOTGW_RAUC_KEY_DIR}/fit"
    UBOOT_SIGN_KEYNAME = "iotgw-fit-dev"

  module_signing: |
    # === Kernel module signing (OPTIONAL, but required for rootfs-only OTA) ===
    # Leave unset and Kbuild auto-generates a throwaway signing key on every
    # kernel build. The kernel then trusts only that key, so modules built
    # against build N cannot load on build N+1's kernel (this distro sets
    # CONFIG_MODULE_SIG_FORCE=y). Point it at a persistent operator key to
    # decouple kernel and module rebuilds.
    #
    # Generate one per docs/KERNEL.md ("Persistent module-signing key"). The
    # PEM must hold BOTH the private key and its certificate.
    #
    # This is a FILE on the build host with no hardware protection — fine for
    # lab/dev images, not a production posture. A production key belongs in the
    # same HSM/YubiKey handling as the FIT key (docs/FIT_BOOT_SIGNING.md).
    # IOTGW_MODULE_SIG_KEY_FILE = "${IOTGW_RAUC_KEY_DIR}/module-signing/iotgw-module-signing-dev.pem"

  fit_dtb_yk_pubkey_trust: |
    # Optional: U-Boot control-FDT trust rotation for FIT signing keys.
    #
    # The kernel-fit recipe injects FIT public keys into the deployed
    # DTB so U-Boot's control FDT exposes /signature/key-<NAME> nodes
    # and enforces signed-FIT boot at runtime. Two trust roots can be
    # injected side-by-side during a key rotation:
    #
    #   - File-key (default ON): legacy build-time signing key, located
    #     at ${UBOOT_SIGN_KEYDIR}/${UBOOT_SIGN_KEYNAME}.{crt,key}. The
    #     FIT itself is signed with this key during bitbake.
    #   - YubiKey (off by default): public certificate exported from
    #     PIV slot 9a, located at ${IOTGW_FIT_YK_KEYDIR}/${IOTGW_FIT_YK_KEYNAME}.crt.
    #     No private key required on the build host. The FIT itself is
    #     post-build resigned via scripts/fit-signing/sign_fit.py against the
    #     hardware-resident private key.
    #
    # Rotation window (both gates ON): DTB carries both pubkeys and
    # /signature/required-mode = "any" so a FIT signed by either root
    # verifies. Required while some bundles are file-signed and some
    # are HSM-signed.
    #
    # Production cutover (IOTGW_FIT_TRUST_FILE_KEY=0, only YK trusted):
    # the recipe injects only the YK pubkey and leaves required-mode
    # unset (single trust root — U-Boot's default verify semantics).
    # Use the kas/fit-release-trust.yml overlay (composed automatically
    # by make prod / bundle-prod-full / bundle-prod-full-fit) rather than
    # setting this gate in local.yml; that overlay also force-disables the
    # SoftHSM gate so a dev local.yml cannot leak it into a release.
    # Operator pre-flight: export slot 9a public cert with
    # `ykman piv certificates export 9a ${IOTGW_FIT_YK_KEYDIR}/${IOTGW_FIT_YK_KEYNAME}.crt`.
    #
    # Setting both gates to 0 is a build-time error.
    # IOTGW_FIT_TRUST_FILE_KEY = "1"
    # IOTGW_FIT_TRUST_YK_KEY = "1"
    # IOTGW_FIT_YK_KEYDIR = "${IOTGW_RAUC_KEY_DIR}/rauc-ca/fit"
    # IOTGW_FIT_YK_KEYNAME = "iotgw-fit-yk-2027"

  fit_dtb_softhsm_dev_trust: |
    # DEV-ONLY: optional SoftHSM-based FIT-signing trust root for engineers
    # without a YubiKey. SoftHSM stores keys in software, NOT a hardware
    # token — never enable this gate on a build intended for the field.
    # Operator provisions the dev key + cert via softhsm2-util + pkcs11-tool;
    # see docs/FIT_BOOT_SIGNING.md for the runbook.
    #
    # Two reasonable dev models:
    #
    #   1. Dual dev trust (recommended for shared hardware) — flip both
    #      YK and SoftHSM gates ON. DTB carries iotgw-fit-yk-2027 AND
    #      iotgw-fit-softhsm-dev with /signature/required-mode = "any".
    #      The same image boots either a real YK-signed FIT or a
    #      SoftHSM-signed FIT, so a YK-less developer and a YK-equipped
    #      developer can share the device for testing.
    #
    #   2. SoftHSM-only dev — leave YK gate OFF, flip SoftHSM gate ON.
    #      DTB trusts only iotgw-fit-softhsm-dev (single root, no
    #      required-mode written). Simpler but the device cannot boot
    #      production-style YK-signed artifacts.
    #
    # Any production build must keep IOTGW_FIT_TRUST_SOFTHSM_KEY off so
    # the device's runtime trust store contains only YubiKey-backed
    # roots.
    #
    # IOTGW_FIT_TRUST_SOFTHSM_KEY = "1"
    # IOTGW_FIT_SOFTHSM_KEYDIR = "${IOTGW_RAUC_KEY_DIR}/softhsm/fit"
    # IOTGW_FIT_SOFTHSM_KEYNAME = "iotgw-fit-softhsm-dev"

  buildhistory_downgrade_notes: |
    # Developer note: for intentional downgrade/maintenance tests (for example
    # switching kernel line 6.18 -> 6.12), package-history QA can trigger:
    #   version-going-backwards
    # Preferred temporary knob (demote to warning):
    # ERROR_QA:remove = "version-going-backwards"
    # WARN_QA:append = " version-going-backwards"
    #
    # Recipe-scoped alternative:
    # ERROR_QA:remove:pn-perf = "version-going-backwards"
    # WARN_QA:append:pn-perf = " version-going-backwards"
    #
    # Broader alternative (keeps image history but skips package history):
    # BUILDHISTORY_FEATURES:remove = "package"

  tpm: |
    # === TPM (SLB9672 over SPI) — one switch, off by default ===
    # Composing kas/tpm.yml (add it to `includes:` above) brings the TPM layers
    # and sets IOTGW_ENABLE_TPM = "1", which turns on together: the SPI TPM
    # profile + firmware overlay, the crypto providers (tpm2-pkcs11,
    # tpm2-openssl, tpm2-tss-engine), OTA updater TPM mTLS and PKCS#11 RAUC
    # streaming. The target then needs its TPM-backed device keys provisioned
    # (scripts/ota/ota-pkcs11-provision-check.sh), or streaming cannot
    # authenticate.
    # Keep kas/tpm.yml included but switch the TPM off (its layers also carry
    # meta-integrity, which IMA needs) by overriding the same block name:
    # tpm_spi: |
    #   IOTGW_ENABLE_TPM = "0"
    # IOTGW_ENABLE_TPM = "1"
    # Optional overlay override if wiring/CS differs:
    # IOTGW_TPM_DTO_OVERLAY = "tpm-slb9670"

  ota_tpm_mtls: |
    # OTA updater TPM-backed mTLS key flow. Follows IOTGW_ENABLE_TPM; set it
    # only to diverge from the switch. When enabled:
    # - ota-updater uses TPM key handle URI instead of /etc/ota/device.key
    # - ota-certs allows keyless cert provisioning (device.crt + ca.crt)
    # IOTGW_ENABLE_OTA_TPM_MTLS = "1"
    # IOTGW_OTA_TPM_KEY_URI = "handle:0x81000001"
    # IOTGW_OTA_TPM_KEY_ENGINE = "tpm2tss"
    # IOTGW_OTA_OPENSSL_CONF = "/etc/ota/openssl-tpm2.cnf"

  rauc_pkcs11_streaming: |
    # RAUC streaming key mode. Follows IOTGW_ENABLE_TPM (pkcs11 with the TPM on,
    # file with it off); set it only to diverge from the switch.
    # IOTGW_RAUC_STREAMING_KEY_MODE = "pkcs11"
    # IOTGW_RAUC_PKCS11_BACKEND = "tpm2"
    # TPM2 preset (defaults in layer):
    # IOTGW_RAUC_PKCS11_TLS_KEY_TPM2 = "pkcs11:token=iotgw;object=rauc-client-key;type=private;pin-source=file:/etc/ota/pkcs11-pin"
    # TPM2 PKCS#11 DB location for RAUC sandbox-helper (persistent /data):
    # IOTGW_TPM2_PKCS11_STORE = "/data/tpm2_pkcs11"
    # Custom backend example:
    # IOTGW_RAUC_PKCS11_TLS_KEY_CUSTOM = "pkcs11:token=<token>;object=<key>;type=private"
    # IOTGW_RAUC_PKCS11_MODULE_CUSTOM = "/usr/lib/pkcs11/<provider>.so"
    # IOTGW_RAUC_PKCS11_PROVIDER_PACKAGES_CUSTOM = "<provider-package>"

  rauc_bundle_encryption: |
    # === Encrypted RAUC bundles — ON BY DEFAULT ===
    #
    # Nothing needs to be set here to GET encryption; it is the tracked
    # default. What a fresh clone does need is a recipient certificate, and
    # the cheapest way to supply one is RAUC_OTA_CA_DIR in the block above:
    # IOTGW_RAUC_BUNDLE_ENCRYPT_RECIPIENTS then defaults to
    # <RAUC_OTA_CA_DIR>/device-filekey.crt.
    #
    # Without either, a bundle build FAILS with an actionable message. It does
    # not fall back to an unencrypted bundle — that fallback is precisely the
    # accident this posture exists to prevent.
    #
    # Override the recipient only to point somewhere else, e.g. a PEM holding
    # several device certificates (rauc encrypts to every certificate in the
    # file):
    # IOTGW_RAUC_BUNDLE_ENCRYPT_RECIPIENTS = "/home/you/rauc-keys/ota-dev-ca/recipients.pem"
    #
    # Target-side decryption identity. Defaults already match what
    # ota-certs-provision installs, so these are rarely needed:
    # IOTGW_RAUC_ENCRYPTION_KEY = "/etc/ota/device.key"    # required by RAUC
    # IOTGW_RAUC_ENCRYPTION_CERT = "/etc/ota/device.crt"   # optional; "" = try all recipients
    #
    # --- Opt out to unencrypted verity bundles (development / compat testing) ---
    # Produces a signed but UNENCRYPTED bundle, and an image whose
    # /etc/rauc/system.conf has no [encryption] stanza:
    # IOTGW_ENABLE_RAUC_BUNDLE_ENCRYPTION = "0"
    #
    # Confirm what a finished bundle actually is, from the artifact itself:
    #   rauc info --no-verify <bundle>.raucb        # read 'Bundle Format:'

  ota_feature_profiles: |
    # Profile A: file-key mTLS, bundles UNENCRYPTED (verity opt-out).
    # This is no longer the baseline — it is a deliberate downgrade of the
    # default posture, useful for compatibility testing.
    # IOTGW_ENABLE_OTA_TPM_MTLS = "0"
    # IOTGW_RAUC_STREAMING_KEY_MODE = "file"
    # IOTGW_ENABLE_RAUC_BUNDLE_ENCRYPTION = "0"
    # Profile A': the DEFAULT — file-key mTLS, bundles encrypted (crypt).
    # Needs only a recipient source:
    # RAUC_OTA_CA_DIR = "$HOME/rauc-keys/ota-dev-ca"
    # Profile B: full TPM + PKCS#11 + encrypted-bundle lane (include
    # kas/tpm.yml; its IOTGW_ENABLE_TPM = "1" sets the TPM mTLS and PKCS#11
    # streaming defaults)
    # IOTGW_ENABLE_TPM = "1"
    # IOTGW_ENABLE_RAUC_BUNDLE_ENCRYPTION = "1"
    # IOTGW_RAUC_BUNDLE_ENCRYPT_RECIPIENTS = "/home/you/rauc-keys/ota-dev-ca/device-filekey.crt"
    # IOTGW_RAUC_ENCRYPTION_KEY = "/etc/ota/device.key"
    # IOTGW_RAUC_ENCRYPTION_CERT = "/etc/ota/device.crt"

  btf_core_dev_toggle: |
    # Optional kernel BTF/CO-RE lab metadata gate.
    # Keep disabled by default; enable for eBPF/libbpf CO-RE workflows.
    # IOTGW_ENABLE_BTF_CORE_DEV = "1"

  # --- Feature switches (each is a layer on/off; off unless noted) ---
  otbr_toggle: |
    # Native OpenThread Border Router (otbr-rpi5) in dev + prod images. Needs an
    # RCP radio dongle on the target. kas/otbr.yml sets the same switch.
    # IOTGW_ENABLE_OTBR = "1"
    # Infrastructure link of the Border Router: wlan0 (default) or br0 (wired;
    # gives br0 an IPv6 link-local address and accepts router advertisements).
    # IOTGW_OTBR_INFRA_IFACE = "br0"
  containers_toggle: |
    # Image/build tooling (buildah/skopeo/podman-compose). The container runtime
    # itself ships in every image and is not a switch.
    # IOTGW_ENABLE_CONTAINERS_IMAGE_TOOLS = "1"
  ima_toggle: |
    # IMA measurement (kernel fragment + userspace tooling). Needs
    # meta-integrity, which kas/tpm.yml composes.
    # IOTGW_ENABLE_IMA = "1"
  crash_debug_toggle: |
    # Lab crash-debug profile (DT ramoops + panic/oops/sysrq flow).
    # IOTGW_ENABLE_CRASH_DEBUG_DEV = "1"
  rauc_adaptive: |
    # RAUC adaptive updates (block-hash-index).
    # IOTGW_RAUC_ADAPTIVE = "1"
  kernel_features: |
    # Kernel feature fragments. Setting this REPLACES the list, including what
    # kas/desktop.yml adds, so only set it to pin a set deliberately.
    # IOTGW_KERNEL_FEATURES = "igw_compute_media igw_containers igw_networking_iot igw_security_prod igw_ima igw_observability_dev"
  uboot_hardening: |
    # Base U-Boot features (surface_reduce fit_enforce watchdog) come from the
    # distro. Force a set locally, e.g. to test appliance_lockdown on dev:
    # IOTGW_UBOOT_FEATURES = "surface_reduce fit_enforce watchdog appliance_lockdown"
  ota_updater: |
    # OTA updater endpoint (mTLS) and manifest path on that server.
    # IOTGW_OTA_SERVER_URL = "https://ota.example.invalid:8443"
    # IOTGW_OTA_MANIFEST_PATH = "/api/v1/manifest.json"
  nodejs_runtime: |
    # The OTBR web UI needs a newer Node.js than the default 20.x.
    # IOTGW_NODEJS_BIN_VERSION = "22.22.0"
  rtc_test: |
    # RPi5 RTC battery charge target (3.0 V), for bring-up validation only.
    # RPI_EXTRA_CONFIG:append = "\ndtparam=rtc_bbat_vchg=3000000\n"

  # --- Build host and developer settings ---
  parallelism: |
    # Match your build host; rpi5.yml carries the defaults.
    # BB_NUMBER_THREADS = "10"
    # PARALLEL_MAKE = "-j12"
  artifact_archive: |
    # deploy/ keeps only what the last composition reaches: starting a desktop
    # or prod build (even `bitbake -n`) removes the dev bundle, kernel and
    # U-Boot. Set a directory outside build/ and each image and bundle copies
    # itself and its boot chain there once built (hardlinks on the same
    # filesystem). Keeps the newest KEEP folders per recipe.
    # IOTGW_ARTIFACT_ARCHIVE_DIR = "/home/you/yocto-cache/artifacts"
    # IOTGW_ARTIFACT_ARCHIVE_KEEP = "5"
  rm_work_exclude: |
    # Keep kernel/U-Boot workdirs for debugging. rm_work itself comes from
    # rpi5.yml; do not remove it (build/tmp grows into the hundreds of GB).
    # RM_WORK_EXCLUDE += " linux-iotgw-mainline u-boot"
    # While working on SELinux policy, keep the refpolicy tree too:
    # RM_WORK_EXCLUDE += " refpolicy-mcs"
  prod_ops_key: |
    # Prod's only login: the OTA operator account (key-only SSH, staff_t, may
    # stage and install bundles, cannot elevate). The prod build fails without it.
    # IOTGW_PROD_OPS_AUTH_KEYS_FILE = "/home/you/.ssh/iotgw-ops.pub"
  bench_console_passwords: |
    # Console passwords for the bench (dev/desktop only; prod keeps root "*").
    # The layer ships no password: both hashes default to "*" (no password
    # login; SSH keys only). Generate: openssl passwd -6
    # IOTGW_ROOT_PASSWORD_HASH = "$6$...."
    # IOTGW_DEVEL_PASSWORD_HASH = "$6$...."
  selinux_mode: |
    # Every image boots SELinux enforcing (iotgw-common.inc). Permissive only to
    # collect the access surface of new software before its policy exists;
    # applies to every image built in this composition. See docs/SELINUX.md.
    # IOTGW_SELINUX_MODE = "permissive"
  sdk_tooling: |
    # Extra target dev packages in the SDK (for app cross-builds).
    # TOOLCHAIN_TARGET_TASK:append = " pkgconf-dev libmnl-dev systemd-dev sdbus-c++-dev nlohmann-json-dev"
  desktop_apps: |
    # Desktop HDMI app (hdmi-wave-demo): fetched from GitHub by default; point
    # it at a local clone only to build unpushed work.
    # HDMI_WAVE_DEMO_GIT = "git:///home/you/src/hdmi-wave-demo;protocol=file"
  externalsrc_dev: |
    # Build a project from a local checkout instead of its pinned GitHub SRCREV.
    # Development only; released images use the pinned SRCREV. The global
    # INHERIT is required: a recipe's conditional inherit does not see a
    # pn-scoped EXTERNALSRC override at parse time. externalsrc is a no-op
    # for recipes with no EXTERNALSRC set. After a PV bump, delete the
    # checkout's build-sdk directory (stale CMake cache).

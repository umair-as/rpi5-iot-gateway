# IoT Gateway fstab (Raspberry Pi 5, RAUC A/B + GPT)
# Root filesystem is mounted read-only for atomic OTA behavior.
# Persistent writable state is on the partition named "data", mounted at /data.
# /data is deliberately NOT listed: iotgw-preinit (init= on the signed command
# line) owns it. Pre-init runs e2fsck, decides whether the partition is usable,
# mounts it before PID 1 and assembles /etc, /root (tmpfs overlays) and /home
# (bound from /data/home). When it declines (no device, fsck failure or
# timeout, mount failure) it boots degraded on purpose. An fstab entry would
# make systemd retry that decision: wait for the device and fail local-fs, or
# mount a filesystem that failed fsck. Units that need /data skip themselves
# with ConditionPathIsMountPoint=/data and order with After=data.mount (the
# unit systemd derives from the live mount table).
# LABEL-based mounts are used to avoid dependency on partition numbering.

/dev/root            /                    auto       ro                    1  1
# fsck pass 2 on the FAT partitions: a dirty bit left by a power cut or hard
# reset is sticky (a clean unmount does not clear it) until fsck.vfat -a runs.
# nofail: an unrepairable FAT must not stop the boot; rauc and U-Boot env users
# fail on their own and the system stays reachable.
LABEL=boot           /boot                vfat       nofail,nodev,nosuid,noexec,noatime,nodiratime   0  2
LABEL=ubootenv       /uboot-env           vfat       rw,nofail,nodev,nosuid,noexec,noatime,nodiratime,umask=0077   0  2
proc                 /proc                proc       nosuid,nodev,noexec,hidepid=2 0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0
tmpfs                /dev/shm             tmpfs      nodev,nosuid,noexec   0  0

# br0 carries the LAN L3 address (DHCPv4, IPv6 ignored). The eth0 port
# (15-eth0.network) has no address of its own; wlan0 is a separate WiFi
# uplink (25-wlan0.network).
[Match]
Name=br0

[Network]
DHCP=ipv4
LinkLocalAddressing=no
IPv6AcceptRA=no

[DHCPv4]
# The bridge carries eth0's factory MAC (10-br0.netdev); keep the DHCP client
# id tied to the MAC so lease identity is stable across reboots and in
# recovery mode.
ClientIdentifier=mac
# The hostname is provisioned identity, not a DHCP option: the server must not
# set it (networkd would ask hostnamed, which asks polkit, for every lease).
UseHostname=no

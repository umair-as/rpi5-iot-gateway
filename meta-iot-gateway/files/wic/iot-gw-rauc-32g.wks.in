# IoT Gateway OS -- RAUC A/B partition layout (32 GiB SD card)
# Target: Raspberry Pi 5, GPT, mmcblk0
#
#  mmcblk0 (32 GiB SD card)
#  +----------+----------+--------------+--------------+-----------+
#  |   boot   | ubootenv |    rootA     |    rootB     |   data    |
#  |   (p1)   |   (p2)   |     (p3)     |     (p4)     |   (p5)   |
#  |  256 MiB |  16 MiB  |    6 GiB     |    6 GiB     |  12 GiB  |
#  |   vfat   |   vfat   |     ext4     |     ext4     |   ext4   |
#  +----------+----------+--------------+--------------+-----------+
#  | /boot    |/uboot-env|  / (active)  |  (standby)   |  /data   |
#  | FIT,DTB, | fw_env   | read-only    | RAUC update  |persistent|
#  | config.txt| RAUC vars| rootfs      | target       | storage  |
#  +----------+----------+--------------+--------------+-----------+
#                                   OTA swap ^-----------^
#
# Note: runtime mount options (noatime/commit) are set in /etc/fstab, not here.
# Root slot source: IOTGW_WKS_ROOT_A_ARGS / IOTGW_WKS_ROOT_B_ARGS (set by
# iotgw-verity-image.bbclass) select the prebuilt ext4+dm-verity-hash-tree
# image via the rawcopy plugin. rawcopy runs a filesystem labeller on the
# copied image when a --label is present, which would rewrite the ext4
# superblock after the hash tree was computed and invalidate the root hash, so
# the root slots carry no --label. The GPT partition name (what RAUC selects
# slots by) comes from --part-name.

part /boot      --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot     --active --align 4096 --size 256M     --use-uuid --no-fstab-update
part /uboot-env                            --ondisk mmcblk0 --fstype=vfat --label ubootenv          --align 4096 --size 16M      --use-uuid --no-fstab-update
part /          ${IOTGW_WKS_ROOT_A_ARGS} --ondisk mmcblk0 --part-name rootA --align 4096 --fixed-size 6G --uuid a5a5a5a5-0000-4a5a-8a5a-00000000000a
part            ${IOTGW_WKS_ROOT_B_ARGS} --ondisk mmcblk0 --part-name rootB --align 4096 --fixed-size 6G --uuid b5b5b5b5-0000-4b5b-8b5b-00000000000b
part /data                                 --ondisk mmcblk0 --fstype=ext4 --label data               --align 4096 --size 12G     --fsoptions "defaults" --no-fstab-update

bootloader --ptable gpt

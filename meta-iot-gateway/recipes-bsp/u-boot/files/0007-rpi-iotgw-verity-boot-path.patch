From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Umair Ahmed Shah <umairahmedshah@hotmail.com>
Date: Wed, 21 Oct 2026 18:00:00 +0200
Subject: [PATCH] rpi: env: boot the signed per-slot FIT's own device tree for runtime dm-verity

With runtime dm-verity the dm-verity table, including the root hash, is the
kernel command line carried in /chosen/bootargs of the per-slot signed FIT's
device tree, so the FIT signature authenticates the root. For that to hold,
U-Boot has to boot the FIT's own device tree and must not replace its command
line.

iotgw_set_bootargs used to copy the firmware command line and append
root=PARTUUID, rauc.slot and the writable EXTRA_KERNEL_ARGS. It now keeps only
the partition-presence check (fail fast and mark the slot non-bootable), then:

* clears the environment `bootargs`, so fdt_chosen() does not overwrite the
  FIT's /chosen/bootargs;
* unsets the environment `fdt_addr`, so the unchanged
  `bootm <fit> - ${fdt_addr}` in iotgw_exec_fit expands to `bootm <fit> -` and
  selects the FIT configuration's own fdt instead of the firmware's. The
  firmware fix-ups are still applied: ft_board_setup() reads gd->fdt_blob, not
  the environment variable, and update_fdt_from_fw() does not copy
  /chosen/bootargs.

iotgw_load_boot drops the fallback to the generic fitImage. That image carries
no verity table, so falling back to it would boot an unauthenticated root.

Applies only to builds with runtime dm-verity enabled. The environment of a
development image is still writable, so this authenticates the root against
offline tampering and a corrupt slot; it is not a hardware-rooted chain.

Upstream-Status: Inappropriate [product specific - runtime dm-verity boot path]
Assisted-by: claude-code:claude-sonnet-5-5
---
diff --git a/board/raspberrypi/rpi/rpi.env b/board/raspberrypi/rpi/rpi.env
index be4b71c8..bab5372e 100644
--- a/board/raspberrypi/rpi/rpi.env
+++ b/board/raspberrypi/rpi/rpi.env
@@ -84,8 +84,8 @@ iotgw_wdt_stop=if wdt dev ${iotgw_wdt_dev}; then wdt stop; echo [IOTGW] watchdog
 iotgw_try_a=if test -z "${rauc_slot}"; then if itest ${BOOT_A_LEFT} -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv rauc_slot A; setenv rootpartnum 3; fi; fi
 iotgw_try_b=if test -z "${rauc_slot}"; then if itest ${BOOT_B_LEFT} -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv rauc_slot B; setenv rootpartnum 4; fi; fi
 iotgw_rauc_select=test -n "${BOOT_ORDER}" || setenv BOOT_ORDER A B; test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3; test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3; setenv rauc_slot; for BOOT_SLOT in ${BOOT_ORDER}; do if test x${BOOT_SLOT} = xA; then run iotgw_try_a; else run iotgw_try_b; fi; done
-iotgw_set_bootargs=if part uuid mmc 0:${rootpartnum} rootpartuuid; then fdt addr ${fdt_addr}; fdt get value bootargs /chosen bootargs; setenv bootargs ${bootargs} root=PARTUUID=${rootpartuuid} rootwait rauc.slot=${rauc_slot}; if test -n "${EXTRA_KERNEL_ARGS}"; then setenv bootargs ${bootargs} ${EXTRA_KERNEL_ARGS}; fi; else echo [RAUC] part uuid failed; setenv BOOT_${rauc_slot}_LEFT 0; saveenv; reset; fi
-iotgw_load_boot=if test "x${rauc_slot}" = "xA"; then setenv _fit fitImage-a; elif test "x${rauc_slot}" = "xB"; then setenv _fit fitImage-b; else setenv _fit fitImage; fi; if fatload mmc 0:1 ${iotgw_fit_addr_r} ${_fit}; then echo [IOTGW] FIT ${_fit} loaded; elif fatload mmc 0:1 ${iotgw_fit_addr_r} fitImage; then echo [IOTGW] FIT fallback fitImage loaded; else echo [IOTGW] FIT load failed; setenv BOOT_${rauc_slot}_LEFT 0; saveenv; reset; fi
+iotgw_set_bootargs=if part uuid mmc 0:${rootpartnum} rootpartuuid; then setenv bootargs; setenv fdt_addr; else echo [RAUC] part uuid failed; setenv BOOT_${rauc_slot}_LEFT 0; saveenv; reset; fi
+iotgw_load_boot=if test "x${rauc_slot}" = "xA"; then setenv _fit fitImage-a; elif test "x${rauc_slot}" = "xB"; then setenv _fit fitImage-b; else setenv _fit fitImage-none; fi; if fatload mmc 0:1 ${iotgw_fit_addr_r} ${_fit}; then echo [IOTGW] FIT ${_fit} loaded; else echo [IOTGW] FIT ${_fit} load failed, no fallback; setenv BOOT_${rauc_slot}_LEFT 0; saveenv; reset; fi
 iotgw_exec_fit=run iotgw_wdt_stop; if test -n "${iotgw_fit_conf}"; then bootm ${iotgw_fit_addr_r}#${iotgw_fit_conf} - ${fdt_addr}; else bootm ${iotgw_fit_addr_r} - ${fdt_addr}; fi; echo [IOTGW] bootm returned for slot ${rauc_slot}: marking slot non-bootable; setenv BOOT_${rauc_slot}_LEFT 0; saveenv; reset
 iotgw_halt=run iotgw_wdt_stop; echo [IOTGW][HALT] All RAUC slots exhausted (A_LEFT=${BOOT_A_LEFT} B_LEFT=${BOOT_B_LEFT}); echo [IOTGW][HALT] No bootable FIT image. Out-of-band recovery required (serial console or SD reflash); while itest 1 -eq 1; do sleep 60; echo [IOTGW][HALT] halted; done
 bootcmd=run iotgw_wdt_start; run iotgw_rauc_select; if test -z "${rauc_slot}"; then run iotgw_halt; fi; run iotgw_set_bootargs; run iotgw_load_boot; saveenv; run iotgw_exec_fit

# wpa_supplicant build configuration for the iotgw distro (replaces upstream's
# everything-on defconfig, to cut the wireless attack surface).
#
# The gateway is a Wi-Fi STATION on WPA2/WPA3-Personal networks, associated by
# wpa_supplicant@<iface> and addressed by systemd-networkd. Everything the
# station role does not need is left out, because wpa_supplicant parses frames
# from any transmitter in range BEFORE any authentication: beacon/probe IEs on
# every scan, EAPOL from any AP announcing our SSID, and, with P2P built in, a
# P2P-device interface that answers P2P probe/action frames from arbitrary
# peers. P2P group formation uses WPS provisioning, which is the closest
# analogue on this board to Broadcom's WPSplinter (AP-side WPS reassembly).
#
# Deliberately NOT enabled (upstream defconfig has them on):
#   CONFIG_WPS, CONFIG_P2P, CONFIG_WIFI_DISPLAY   WPS/P2P/Miracast
#   CONFIG_AP, CONFIG_IBSS_RSN                    AP and IBSS roles
#   CONFIG_TDLS                                   direct-link setup with peers
#   CONFIG_HS20, CONFIG_INTERWORKING              Hotspot 2.0 / ANQP
#   CONFIG_DPP, CONFIG_DPP2                       Easy Connect provisioning
#   CONFIG_MACSEC, CONFIG_DRIVER_MACSEC_LINUX     wired MACsec
#   CONFIG_DRIVER_WEXT, CONFIG_DRIVER_WIRED       legacy / wired drivers
#   CONFIG_EAP_*                                  no WPA-Enterprise today; when
#                                                 it is needed, enable exactly
#                                                 the method(s) in use (TLS,
#                                                 PEAP/MSCHAPv2 or TTLS)
#   CONFIG_SMARTCARD, CONFIG_PKCS12, CONFIG_OWE   unused
#   CONFIG_DEBUG_FILE                             no debug log files on disk
#
# Kept:
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
# Control socket for wpa_cli (ctrl_interface=DIR=/run/wpa_supplicant) and the
# D-Bus interface the upstream dbus-activated unit expects (the activation path
# is masked on this image; keeping the code avoids a half-installed unit).
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
CONFIG_BACKEND=file
# EAPOL state machine: required for WPA-Enterprise, harmless for PSK; kept so
# that enabling an EAP method later is a one-line change.
CONFIG_IEEE8021X_EAPOL=y
# WPA3-Personal.
CONFIG_SAE=y
# Fast BSS transition (FT-PSK roaming between APs of one ESS).
CONFIG_IEEE80211R=y
# Operating classes / capability parsing for the radios in use.
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211BE=y
# Background scanning for roaming.
CONFIG_BGSCAN_SIMPLE=y
CONFIG_IPV6=y
CONFIG_DEBUG_SYSLOG=y
# CONFIG_TLS is appended by the recipe from PACKAGECONFIG (openssl).
